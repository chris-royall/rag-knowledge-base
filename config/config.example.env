# RAG Knowledge Base Configuration - Example Template
# Copy this file and rename it to match your environment (e.g., config.prod.env)
# Edit the values below to customize your deployment

## AWS environment config
# AWS region where resources will be deployed
REGION=eu-west-2
# AWS CLI profile to use for deployment
AWS_PROFILE=default

# Publicly accessible URL to website
DOCS_BASE_URL=https://your-company.com

## AWS OpenSearch service parameters
# Basic configuration
# How many computers (servers) run your search engine
OPEN_SEARCH_INSTANCE_COUNT=1  # Must be ≥2 when OPEN_SEARCH_ZONE_AWARENESS_ENABLED=true
# How powerful each computer is (t3.small for testing, m6g.large+ for production)
OPEN_SEARCH_INSTANCE_TYPE=t3.small.search

# Multi-AZ configuration
# Enable deployment across multiple availability zones for high availability
OPEN_SEARCH_ZONE_AWARENESS_ENABLED=false
# ↳ Only used when OPEN_SEARCH_ZONE_AWARENESS_ENABLED=true:
# Enable standby instances in additional AZs for maximum reliability
OPEN_SEARCH_MULTI_AZ_WITH_STANDBY_ENABLED=false
# Number of availability zones to deploy across
OPEN_SEARCH_AVAILABILITY_ZONE_COUNT=1
# ⚠️  VALIDATION: When OPEN_SEARCH_ZONE_AWARENESS_ENABLED=true, OPEN_SEARCH_INSTANCE_COUNT must be ≥2

# EBS storage configuration
# Controls whether OpenSearch uses EBS (persistent) or instance store (ephemeral) storage
OPEN_SEARCH_EBS_ENABLED=true
# ↳ Only used when OPEN_SEARCH_EBS_ENABLED=true:
# Type of EBS volume (gp3, gp2, io1, io2)
OPEN_SEARCH_EBS_VOLUME_TYPE=gp3
# Size in GB of EBS volumes
OPEN_SEARCH_EBS_VOLUME_SIZE=10
# Input/output operations per second for gp3, io1, io2 volumes
OPEN_SEARCH_EBS_IOPS=3000
# Throughput in MB/s for gp3 volumes
OPEN_SEARCH_EBS_THROUGHPUT=125

## AWS service parameters
# Name of the CloudFormation stack - must be unique in your AWS account/region
STACK_NAME=your-company-rag-kb
# The Application that uses the resources
APPLICATION="your-application"
# Individual or Team responsible for managing the resources
OWNER="User Name"
# S3 bucket name for storing knowledge base
BUCKET_NAME=your-company-knowledge-base
# OpenSearch index name for vector storage
INDEX_NAME=your-kb-index
# Log level
LOG_LEVEL=INFO

# API Authorization Cognito User Pool
# Enable JWT authorization
AUTHORIZATION_ENABLED=true
# ↳ Only used when AUTHORIZATION_ENABLED=true:
# Cognito User Pool ID
USER_POOL_ID=eu-west-2_ABCDEF123
# Cognito App Client ID
USER_POOL_CLIENT_ID=1234abcd5678efghijkl9012

## Bedrock model lifecyle - https://docs.aws.amazon.com/bedrock/latest/userguide/model-lifecycle.html
# Bedrock model for text embeddings (converts text to vectors)
BEDROCK_OPENSEARCH_MODEL=amazon.titan-embed-text-v2:0
# Bedrock model for generating responses from retrieved knowledge
BEDROCK_KNOWLEDGE_BASE_MODEL=anthropic.claude-3-7-sonnet-20250219-v1:0

## Chat Bot prompt configuration
# Role description of the chat bot
CHAT_BOT_ROLE="Knowledge Base chat bot"
# Primary objective of the chat bot
CHAT_BOT_OBJECTIVE="Provide accurate answers to user questions using the available knowledge base content"
# Tone and personality of the chat bot
CHAT_BOT_TONE="Professional and helpful - respond in a clear and concise manner"
# Behavior rules for the chat bot
CHATBOT_BEHAVIOR_RULES="Always use facts from the knowledge base. If information is not available, clearly state that you do not have the information to answer the question."
